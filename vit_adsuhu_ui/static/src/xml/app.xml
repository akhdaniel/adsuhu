<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vit_adsuhu_ui.App">
        <div class="o_adsuhu_app">
            <div class="o_adsuhu_header">
                <div class="o_adsuhu_header_title">
                    <h1 t-esc="state.analysis.name"/>
                    <div class="o_adsuhu_header_meta">
                        <span class="o_adsuhu_badge" t-if="state.analysis.target_market">
                            <i class="fa fa-globe"/> <t t-esc="state.analysis.target_market"/>
                        </span>
                        <span class="o_adsuhu_badge o_adsuhu_badge_muted" t-if="state.analysis.tags">
                            <i class="fa fa-tags"/> <t t-esc="state.analysis.tags"/>
                        </span>
                    </div>
                </div>
                <a t-att-href="'/product_analysis/' + state.analysis.id"
                    class="o_adsuhu_link" target="_blank">
                    <i class="fa fa-external-link"/> Classic report
                </a>
            </div>

            <t t-if="state.loading">
                <div class="o_adsuhu_loading">
                    <i class="fa fa-spinner fa-spin"/> Loading analysis…
                </div>
            </t>
            <t t-elif="state.error">
                <div class="o_adsuhu_error">
                    <i class="fa fa-exclamation-triangle"/> <t t-esc="state.error"/>
                </div>
            </t>
            <t t-else="">
                <Stepper stages="stages" current="state.current" onSelect="onSelectStage"/>
                <div class="o_adsuhu_main">
                    <StageView
                        stage="currentStage"
                        hasPrev="Boolean(prevStage)"
                        hasNext="Boolean(nextStage)"
                        onPrev="goPrev"
                        onNext="goNext"
                        onRefresh="refresh"/>
                </div>
            </t>
        </div>
    </t>
</templates>
