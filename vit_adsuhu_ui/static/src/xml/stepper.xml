<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vit_adsuhu_ui.Stepper">
        <nav class="o_adsuhu_stepper">
            <t t-foreach="props.stages" t-as="stage" t-key="stage.key">
                <button
                    t-att-class="'o_adsuhu_step o_adsuhu_step_' + stage.status + (stage.key === props.current ? ' active' : '')"
                    t-att-disabled="stage.status === 'blocked' ? 'true' : undefined"
                    t-att-aria-current="stage.key === props.current ? 'step' : undefined"
                    t-att-data-key="stage.key"
                    t-att-data-status="stage.status"
                    t-on-click="onStageClick"
                    t-att-title="stage.status === 'blocked' ? 'Complete the previous step first' : undefined">
                    <span class="o_adsuhu_step_icon">
                        <t t-if="stage.status === 'done'"><i class="fa fa-check"/></t>
                        <t t-else=""><i t-att-class="'fa ' + stage.icon"/></t>
                    </span>
                    <span class="o_adsuhu_step_label" t-esc="stage.label"/>
                    <span class="o_adsuhu_step_status" t-if="stage.status === 'processing'">
                        <i class="fa fa-spinner fa-spin"/>
                    </span>
                </button>
            </t>
        </nav>
    </t>
</templates>
