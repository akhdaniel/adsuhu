<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="vit_adsuhu_ui.StageView">
        <section class="o_adsuhu_stage">
            <header class="o_adsuhu_stage_head">
                <div class="o_adsuhu_stage_icon">
                    <i t-att-class="'fa ' + stage.icon"/>
                </div>
                <div class="o_adsuhu_stage_head_text">
                    <h2 t-esc="stage.label"/>
                    <p class="o_adsuhu_stage_hint" t-if="stage.hint" t-esc="stage.hint"/>
                </div>
                <span t-att-class="'o_adsuhu_chip o_adsuhu_chip_' + stage.status" t-esc="stage.status"/>
            </header>

            <div class="o_adsuhu_stage_error" t-if="stage.status === 'failed'">
                <i class="fa fa-exclamation-triangle"/> One or more steps failed. Try regenerating.
            </div>

            <div class="o_adsuhu_cards">
                <t t-foreach="stage.cards" t-as="card" t-key="stage.key + '-' + card.id">
                    <div t-att-class="'o_adsuhu_card' + (card.status === 'processing' ? ' processing' : '')"
                        t-att-data-card-key="card.id">
                        <div class="o_adsuhu_card_head">
                            <div class="o_adsuhu_card_head_text">
                                <h3 t-esc="card.title"/>
                                <div class="o_adsuhu_card_sub" t-if="card.subtitle" t-esc="card.subtitle"/>
                            </div>
                            <div class="o_adsuhu_card_head_actions">
                                <button
                                    t-if="card.hasContent"
                                    t-att-class="'o_adsuhu_btn o_adsuhu_btn_ghost o_adsuhu_btn_sm' + (state.copied === ('card-' + card.id) ? ' copied' : '')"
                                    t-on-click="copyCard">
                                    <i t-att-class="'fa ' + (state.copied === ('card-' + card.id) ? 'fa-check' : 'fa-clipboard')"/>
                                    <t t-esc="state.copied === ('card-' + card.id) ? 'Copied!' : 'Copy All'"/>
                                </button>
                                <GenerateButton
                                    t-if="card.action"
                                    action="card.action"
                                    hasContent="card.hasContent"
                                    onDone="props.onRefresh"
                                    disabled="stage.status === 'processing'"/>
                            </div>
                        </div>

                        <div class="o_adsuhu_card_body" t-if="card.hasContent">
                            <div class="o_adsuhu_prose_wrap" t-if="card.content.html &amp;&amp; !card.content.blocks">
                                <div class="o_adsuhu_prose" t-raw="card.content.html"/>
                                <t t-if="card.content.edit_model">
                                    <div class="o_adsuhu_block_edit_bar">
                                        <button class="o_adsuhu_btn_icon" title="Edit"
                                            t-on-click="() => this.startEdit(card.content)">
                                            <i class="fa fa-pencil"/>
                                        </button>
                                    </div>
                                </t>
                            </div>
                            <t t-if="card.content.blocks">
                                <t t-foreach="card.content.blocks" t-as="block" t-key="block.name">
                                    <div class="o_adsuhu_block" t-if="block.html || block.edit_model" t-att-data-key="block.name">
                                        <div class="o_adsuhu_block_head">
                                            <div class="o_adsuhu_block_title" t-esc="block.name"/>
                                            <div class="o_adsuhu_block_actions">
                                                <button
                                                    t-if="block.edit_model &amp;&amp; !isEditing(block)"
                                                    class="o_adsuhu_btn_icon" title="Edit"
                                                    t-on-click="() => this.startEdit(block)">
                                                    <i class="fa fa-pencil"/>
                                                </button>
                                                <button
                                                    t-if="state.copied !== ('blk-' + block.name)"
                                                    class="o_adsuhu_btn_icon" title="Copy"
                                                    t-on-click="copyBlock">
                                                    <i class="fa fa-copy"/>
                                                </button>
                                                <span t-if="state.copied === ('blk-' + block.name)"
                                                    class="o_adsuhu_btn_icon copied">
                                                    <i class="fa fa-check"/>
                                                </span>
                                            </div>
                                        </div>
                                        <t t-if="isEditing(block)">
                                            <textarea class="o_adsuhu_edit_textarea"
                                                t-model="state.editText"
                                                rows="12"/>
                                            <div class="o_adsuhu_edit_actions">
                                                <button class="o_adsuhu_btn o_adsuhu_btn_ghost o_adsuhu_btn_sm"
                                                    t-on-click="() => this.cancelEdit()">
                                                    <i class="fa fa-times"/> Cancel
                                                </button>
                                                <button
                                                    t-att-class="'o_adsuhu_btn o_adsuhu_btn_primary o_adsuhu_btn_sm' + (state.saving ? ' loading' : '')"
                                                    t-att-disabled="state.saving ? 'true' : undefined"
                                                    t-on-click="() => this.saveEdit(block)">
                                                    <i t-att-class="'fa ' + (state.saving ? 'fa-spinner fa-spin' : 'fa-save')"/>
                                                    <t t-esc="state.saving ? 'Saving…' : 'Save'"/>
                                                </button>
                                            </div>
                                        </t>
                                        <t t-else="">
                                            <div class="o_adsuhu_prose" t-raw="block.html"/>
                                        </t>
                                    </div>
                                </t>
                            </t>
                            <ImageGallery
                                t-if="card.images &amp;&amp; card.images.length"
                                card="card"
                                onDone="props.onRefresh"/>
                        </div>
                    </div>
                </t>

                <div class="o_adsuhu_card_empty" t-if="!stage.cards.length">
                    <i class="fa fa-hourglass-half"/> Complete the previous step to unlock this stage.
                </div>
            </div>

            <footer class="o_adsuhu_stage_nav">
                <button class="o_adsuhu_btn o_adsuhu_btn_ghost" t-if="hasPrev" t-on-click="onPrev">
                    <i class="fa fa-arrow-left"/> Previous
                </button>
                <button
                    t-if="stage.status === 'done' &amp;&amp; hasNext"
                    class="o_adsuhu_btn o_adsuhu_btn_primary o_adsuhu_btn_continue"
                    t-on-click="onNext">
                    Continue <i class="fa fa-arrow-right"/>
                </button>
            </footer>
        </section>
    </t>
</templates>
