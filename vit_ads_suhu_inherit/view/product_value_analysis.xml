        <!-- form view -->
        <record id="view_product_value_analysis_form" model="ir.ui.view">
            <field name="name">product_value_analysis_form</field>
            <field name="model">vit.product_value_analysis</field>
            <field name="type">form</field>
            <field name="inherit_id" ref="vit_ads_suhu.view_vit_product_value_analysis_form"/>
            <field name="arch" type="xml">
                <!-- <xpath expr="//form" position="attributes">
                    <attribute name="js_class">ads_form_with_banner</attribute>
                </xpath> -->
                <xpath expr="//form/sheet/group[last()]" position="after">
                    <group>
                        <field name="create_uid" groups="base.group_system"/>
                    </group>
                </xpath>

                <xpath expr="//notebook/page[@name='features']" position="before">
                    <page name="brand_assets" string="Brand Assets">
                        <group>
                            <group>
                                <field name="logo_filename" invisible="1"/>
                                <field name="logo" filename="logo_filename" widget="image" options="{'size': [0, 160]}"/>
                            </group>
                            <group>
                                <field name="kemasan_filename" invisible="1"/>
                                <field name="kemasan" filename="kemasan_filename" widget="image" options="{'size': [0, 160]}"/>
                            </group>
                        </group>
                        <p class="text-muted" colspan="2">
                            When set, these images are attached as reference inputs to image generation so the
                            logo and packaging appear in the generated creative.
                        </p>
                    </page>
                </xpath>

                <xpath expr="//notebook/page[@name='report']/field" position="before">
                    <button type="object" name="generate_output_html" icon="fa-file-text-o">Generate Report</button>
                </xpath>

                <button name="action_generate_report" position="replace"/>
                <button name="action_download_docx" position="replace"/>
                <field name="final_report" position="replace"/>
                <field name="report_template" position="replace"/>
                <xpath expr="//notebook/page[@name='final_reports']/group" position="before">
                    <button type="object" name="action_generate_report" icon="fa-file-text-o">Generate Final Report</button>
                    <button type="object" name="action_download_docx" icon="fa-file-word-o">Download Docx</button>
                </xpath>

            </field>
        </record>
        <!-- search -->
        <!--record id="view_product_value_analysis_search" model="ir.ui.view">
